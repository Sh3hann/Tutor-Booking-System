# Express Server Port
PORT=3001

# MongoDB Connection (falls back to built-in in-memory database if unavailable)
MONGODB_URI=mongodb://localhost:27017/tutors_db

# JWT Signing Secret
JWT_SECRET=replace-with-a-secure-random-secret

# Optional: Local Ollama LLM for AI Assistant (falls back to built-in FAQ engine if unreachable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
